# Neon PostgreSQL Database Connection URL (pooled or standard)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Dedicated Admin Panel URL
NEXT_PUBLIC_ADMIN_URL="https://sompheareak-admin.onrender.com"
